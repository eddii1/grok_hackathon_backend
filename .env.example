# Which provider fleet-probe and the agent use: xai or fireworks (or any OpenAI-compatible NAME
# with NAME_BASE_URL, NAME_API_KEY, NAME_MODEL set). Override per run with --provider.
LLM_PROVIDER=xai

XAI_API_KEY=
XAI_MODEL=grok-4.7

# GLM on Fireworks (vision-capable, serverless)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash

# Optional overrides: <NAME>_BASE_URL, <NAME>_API=responses|chat
# Reasoning effort (low is needed for route planning to finish in time)
XAI_REASONING=low

# Faster model for the per-step go/stop check (default: same as the planner)
CHECK_MODEL=grok-4.20-0309-non-reasoning
CHECK_REASONING=

# Agent decisions in fleet-viewer: a fast non-reasoning model answers in ~2 s (the default reasoning model took 47 s)
SEEK_MODEL=grok-4.20-0309-non-reasoning
